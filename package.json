{
  "name": "prolegoma.com",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "build:ui": "rm -rf dist && npm run build",
    "deploy-local": "rm -rf /var/www/localhost/html/* && cp -r dist/* /var/www/localhost/html",
    "deploy-dev": "ssh jericso@dev.prolegoma.com \"rm -rf /var/www/dev.prolegoma.com/html/*\" && scp -r dist/* jericso@dev.prolegoma.com:/var/www/dev.prolegoma.com/html",
    "deploy-local:full": "npm run build:ui && npm run deploy-local",
    "deploy-dev:full": "npm run build:ui && npm run deploy-dev"
  },
  "dependencies": {
    "axios": "^1.13.5",
    "bootstrap": "^5.3.8",
    "google-map-react": "^2.2.5",
    "react": "^19.2.4",
    "react-bootstrap": "^2.10.10",
    "react-dom": "^19.2.4"
  },
  "devDependencies": {
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.4",
    "eslint": "^9.39.2",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "globals": "^17.3.0",
    "vite": "^7.3.1"
  }
}
